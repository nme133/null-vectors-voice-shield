# Groq API key for Whisper transcription and GPT-OSS conversation analysis
GROQ_API_KEY=

# Groq chat model ID used for conversational analysis (GPT-OSS)
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Path to local Spectra-AASIST3 model directory (contains model.py + model.safetensors)
# Leave empty to download from HuggingFace Hub
SPECTRA_MODEL_PATH=/home/mnt/spectra-model

# Device: "cuda" or "cpu"
DEVICE=cuda

# Server settings
HOST=0.0.0.0
PORT=8000

# Enable demo mode (simulated events, no real inference)
DEMO_MODE=false
